# ==========================================
# SAVORÉ GLOBAL ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# ----------------------------
# 1. SERVER CONFIGURATION
# ----------------------------
PORT=5000
NODE_ENV=development

# ----------------------------
# 2. DATABASE CONFIGURATION
# ----------------------------
MONGO_URI=mongodb://localhost:27017/savore

# ----------------------------
# 3. SECURITY & AUTHENTICATION
# ----------------------------
# Provide a strong, cryptographically secure string for JWT tokens
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# ----------------------------
# 4. PAYMENT SERVICE (STRIPE)
# ----------------------------
# Retrieve keys from your Stripe Dashboard (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ----------------------------
# 5. AI ENGINE (GOOGLE GEMINI)
# ----------------------------
# Retrieve API keys from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------
# 6. CLIENT CONFIGURATION (FRONTEND)
# ----------------------------
# Base API URL used by the client for server handshake. 
# Defaults to localhost in development, should point to backend service domain in production (e.g., Render/Railway)
VITE_API_URL=http://localhost:5000/api
