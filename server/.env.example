# ==========================================
# SAVORÉ BACKEND SERVICE ENVIRONMENT VARIABLES
# ==========================================

# ----------------------------
# 1. SERVER SETTINGS
# ----------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ----------------------------
# 2. DATABASE CONFIGURATION
# ----------------------------
# Connection string for your MongoDB instance (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/savore

# ----------------------------
# 3. SECURITY & SESSION MANAGEMENT
# ----------------------------
# Provide a strong, random, cryptographically secure key for signing JWTs
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# ----------------------------
# 4. STRIPE PAYMENT GATEWAY CONFIGURATION
# ----------------------------
# Retrieve these credentials from your Stripe developer dashboard
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ----------------------------
# 5. GOOGLE GEMINI & GROQ AI ASSISTANT CONFIGURATION
# ----------------------------
# Google Gemini API Key (retrieved from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
# Groq Cloud API Key for ultra-fast (300ms) Llama 3.1 mascot responses (retrieved from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
